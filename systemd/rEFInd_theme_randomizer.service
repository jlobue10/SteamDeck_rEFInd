[Unit]
Description=Randomize Theme on each rEFInd boot

[Service]
Type=oneshot
RemainAfterExit=yes
# Root-owned helper binary on the persistent /etc overlay, NOT anything
# under /home/deck/.local: a root unit must never execute a path the desktop
# user can write, or replacing that file is a password-free root escalation.
ExecStart=/etc/SteamDeck_rEFInd/SteamDeck_rEFInd_helper randomize-theme

[Install]
WantedBy=multi-user.target
